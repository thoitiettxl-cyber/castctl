#!/sbin/sh

umask 022
ui_print() { echo "$1"; }

require_new_magisk() {
  ui_print "*******************************"
  ui_print " Please install Magisk v20.4+! "
  ui_print "*******************************"
  exit 1
}

OUTFD=$2
ZIPFILE=$3
mount /data 2>/dev/null

if [ -f /data/adb/magisk/util_functions.sh ]; then
  . /data/adb/magisk/util_functions.sh
  [ "${MAGISK_VER_CODE:-0}" -lt 20400 ] && require_new_magisk
  install_module
  exit 0
fi

# KernelSU and APatch managers consume updater-script and invoke customize.sh.
exit 1
